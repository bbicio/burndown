# Copy this file to .env and fill in the values
# .env is gitignored — never commit it

# PostgreSQL
POSTGRES_DB=pdash
POSTGRES_USER=pdash
POSTGRES_PASSWORD=changeme

# JWT
JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRES_IN=8h

# Email (SMTP)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=no-reply@example.com
SMTP_PASS=changeme

# App
APP_URL=http://localhost
NODE_ENV=development

# scripts/test-branch.sh — optional port overrides (defaults: 8081/3001/5433/8082)
# TEST_BRANCH_FRONTEND_PORT=8081
# TEST_BRANCH_API_PORT=3001
# TEST_BRANCH_DB_PORT=5433
# TEST_BRANCH_ADMINER_PORT=8082
